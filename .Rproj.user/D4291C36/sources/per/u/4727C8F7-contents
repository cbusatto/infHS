beta0 = rep(0, p+1)
beta0[1] = rnorm(1, 0, sqrt(0.5))
u = rbinom(p0, 1, 0.4)
ix = sample(1:p, p0)
ix_no = setdiff(1:p, ix)
beta0[ix+1] = (-1)^(u) * (0.75 * log(n) / sqrt(n) + abs(rnorm(p0, 0, sqrt(0.75))))

## :::: SIMULATE CO-DATA SOURCES (D = 2) ::::

p01 = 30
p02 = 10
G1size = 50
G2size = 70

