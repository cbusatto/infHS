G1[ix[1:5]] = 1
G1[sample(ix[-c(1:5)], p01-5)] = 1
G1[sample(ix_no, G1size-p01)] = 1

G2 = rep(0, p)
G2[ix[1:5]] = 1
G2[sample(ix[-c(1:5)], p02-5)] = 1
G2[sample(ix_no, G2size-p02)] = 1

Z = list()
Z[[1]] = rep(1, p)
Z[[2]] = model.matrix(~ -1 + as.factor(G1))[, 2]
Z[[3]] = model.matrix(~ -1 + as.factor(G2))[, 2]

D = 2 + 1   ## (intercept included)
md = c(1, 1, 1)

